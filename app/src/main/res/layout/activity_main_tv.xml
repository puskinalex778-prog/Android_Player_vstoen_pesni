<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvMainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="horizontal">

    <!-- COLUMN 1: Left TV Navigation Rail (D-Pad friendly) -->
    <LinearLayout
        android:id="@+id/tvNavRail"
        android:layout_width="206dp"
        android:layout_height="match_parent"
        android:background="@color/bg_rail"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvClockRail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@color/divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navLive"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_tv"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="ТВ каналы"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Избранное"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navRecent"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_history"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Недавние"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navMovies"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_movie"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Фильмы"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navSeries"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_series"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Сериалы"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navEpg"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_epg"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Телепрограмма"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navSearch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Поиск"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/navPlaylists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_playlist"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Плейлисты"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navFreeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Парсер M3U"
                    android:textColor="@color/accent_emerald"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navSettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Настройки"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/navDeviceMode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_focus_row"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_auto"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Режим: ТВ"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- COLUMN 2: Groups / Categories -->
    <LinearLayout
        android:id="@+id/tvGroupsColumn"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvPlaylistHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_focus_row"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:text="Все плейлисты ▾"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroupsTv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- COLUMN 3: Channels / Movies / Series List or Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.35"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ТВ каналы"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnTvViewStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_focus_row"
                android:contentDescription="Вид списка"
                android:padding="8dp"
                android:src="@drawable/ic_view_grid"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnTvSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_focus_row"
                android:contentDescription="Сортировка"
                android:padding="8dp"
                android:src="@drawable/ic_sort"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnTvRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_focus_row"
                android:contentDescription="Обновить"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Inline Search Bar (shown when Search section is active) -->
        <EditText
            android:id="@+id/etSearchTv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_focus_card"
            android:hint="Поиск каналов, фильмов, сериалов..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/tvLoadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelsTv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="20dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Нет добавленных плейлистов"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Добавьте M3U ссылку, локальный файл, Xtream Codes или загрузите Демо-плейлист"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEmptyAddPlaylist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_focus_button"
                    android:minHeight="48dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="10dp"
                    android:text="+ Добавить плейлист"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEmptyDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_focus_button"
                    android:minHeight="44dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="🔍 Парсер и поиск бесплатных M3U"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_emerald" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- COLUMN 4: Right Preview / Live EPG Details Panel -->
    <LinearLayout
        android:id="@+id/tvPreviewPanel"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPreviewLogo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_badge_neutral"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPreviewChannelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Выберите канал"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СЕЙЧАС В ЭФИРЕ"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreviewNowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Нет данных телепрограммы"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreviewNowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbPreviewProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvPreviewNowDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="8"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPreviewNextLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_neutral"
            android:padding="8dp"
            android:text="OK — смотреть • Удерживать OK — меню\nВлево — категории • 0–9 — номер канала"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
