<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnEpgBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_focus_row"
            android:contentDescription="Назад"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Телепрограмма (EPG) и Архив"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDayYesterday"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Вчера"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDayToday"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Сегодня"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDayTomorrow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Завтра"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Two-Column EPG Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Channels -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpgChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:background="@color/bg_surface"
            android:padding="6dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <!-- Right: Programs for selected channel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvEpgSelectedChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Выберите канал"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpgPrograms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEpgEmptyPrograms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Нет программы на выбранный день.\nНажмите «Обновить EPG» в разделе Плейлисты или Настройки."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
