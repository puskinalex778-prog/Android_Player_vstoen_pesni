<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Clean 2-Row Header (fits narrow phones and large TV fonts without clipping!) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <!-- Row 1: Back + Full-width Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnEpgBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_focus_row"
                android:contentDescription="Назад"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Телепрограмма (EPG) и Архив"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Full-width Day Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDayYesterday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_button"
                android:minHeight="40dp"
                android:paddingVertical="8dp"
                android:text="Вчера"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDayToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_button"
                android:minHeight="40dp"
                android:paddingVertical="8dp"
                android:text="Сегодня"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDayTomorrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_button"
                android:minHeight="40dp"
                android:paddingVertical="8dp"
                android:text="Завтра"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Two-Column EPG Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Channels -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpgChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:background="@color/bg_surface"
            android:padding="6dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <!-- Right: Programs for selected channel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvEpgSelectedChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Выберите канал"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpgPrograms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvEpgEmptyPrograms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Нет программы на выбранный день.\nДобавьте телепрограмму (EPG) в Настройках или Плейлистах."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
