<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phoneMainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:id="@+id/phonePlaylistSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhonePlaylistSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Все плейлисты ▾"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPhoneSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Поиск"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPhoneModeSwitch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Режим ТВ / Телефон"
            android:src="@drawable/ic_tv"
            android:tint="@color/accent_cyan" />

        <ImageButton
            android:id="@+id/btnPhoneViewStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Вид"
            android:src="@drawable/ic_view_grid"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnPhonePlaylists"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Плейлисты"
            android:src="@drawable/ic_playlist"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnPhoneSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Настройки"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Collapsible Search Bar -->
    <LinearLayout
        android:id="@+id/phoneSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchPhone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focus_card"
            android:hint="Поиск каналов, фильмов, сериалов..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnPhoneClearSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть поиск"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Horizontal Groups Bar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupsPhone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@color/bg_rail"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp" />

    <!-- Main Content Area with SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshPhone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelsPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/phoneEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPhoneEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Нет добавленных плейлистов"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Добавьте M3U, Xtream Codes или загрузите Демо-плейлист"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnPhoneEmptyAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_focus_button"
                    android:paddingHorizontal="24dp"
                    android:text="+ Добавить плейлист"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnPhoneEmptyDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_focus_row"
                    android:paddingHorizontal="20dp"
                    android:text="Загрузить Демо-плейлист"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/phoneBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        app:itemIconTint="@color/text_secondary"
        app:itemTextColor="@color/text_secondary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/phone_bottom_nav" />

</LinearLayout>
