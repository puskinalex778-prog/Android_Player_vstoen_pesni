<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_focus_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мой плейлист"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlaylistMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="M3U • 0 каналов"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPlaylistUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlaylistRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="↻"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnPlaylistEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="⚙"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnPlaylistDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="✕"
            android:textColor="@color/accent_live" />
    </LinearLayout>
</LinearLayout>
