<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_focus_row"
            android:contentDescription="Назад"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Настройки"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSettingsModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_neutral"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Авто"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Category chips (Phone mode) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSettingsCategoriesPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_rail"
        android:clipToPadding="false"
        android:minHeight="48dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone" />

    <!-- Main body: Left category pane (TV) + Right settings list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSettingsCategoriesTv"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:padding="10dp" />

        <View
            android:id="@+id/settingsDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSettingsItems"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
