<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Clean 2-row Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlaylistsBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_focus_row"
                android:contentDescription="Назад"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Плейлисты и EPG"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRefreshAllPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_focus_button"
                android:minHeight="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="↻ Обновить"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_focus_button"
                android:minHeight="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="+ Добавить"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/playlistsProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Prominent Parser & Free Playlist Search Banner Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQuickFreeSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_focus_button"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="🔍 Парсер и поиск бесплатных M3U / M3U8 (m3u.su, GitHub, РФ и Мир)"
                android:textAllCaps="false"
                android:textColor="@color/accent_emerald"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Quick Add Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickM3uUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="+ По ссылке"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickM3uFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="+ Из памяти (файл)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickXtream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="+ Xtream Codes"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQuickDemo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_focus_button"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="+ Демо HD"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_amber"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ВАШИ ПЛЕЙЛИСТЫ"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvNoPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Список плейлистов пуст. Нажмите «🔍 Парсер и поиск бесплатных M3U» или «+ Добавить»."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="18dp"
                android:background="@color/divider" />

            <!-- EPG Sources Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="ТЕЛЕПРОГРАММА (XMLTV / EPG)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddEpgSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_button"
                    android:minHeight="42dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="+ Добавить EPG"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUpdateEpgNow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_button"
                    android:minHeight="42dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="↻ Обновить EPG"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="В базе EPG: 0 передач"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/epgSourcesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
