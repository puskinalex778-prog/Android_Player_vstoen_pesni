<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageButton
            android:id="@+id/btnPlaylistsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_focus_row"
            android:contentDescription="Назад"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Плейлисты и EPG (Телепрограмма)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshAllPlaylists"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="↻ Обновить всё"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAddPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_focus_button"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="+ Добавить"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/playlistsProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Quick Add Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuickM3uUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:paddingHorizontal="14dp"
                        android:text="+ M3U ссылка"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnQuickXtream"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:paddingHorizontal="14dp"
                        android:text="+ Xtream Codes"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnQuickM3uFile"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:paddingHorizontal="14dp"
                        android:text="+ Из памяти (файл)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnQuickFreeSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_focus_button"
                        android:paddingHorizontal="14dp"
                        android:text="🌐 Бесплатные (РФ и Мир)"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_emerald"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnQuickDemo"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_focus_button"
                        android:paddingHorizontal="14dp"
                        android:text="+ Демо-плейлист"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ВАШИ ПЛЕЙЛИСТЫ"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvNoPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Список плейлистов пуст. Нажмите «+ Добавить» сверху."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="18dp"
                android:background="@color/divider" />

            <!-- EPG Sources Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ИСТОЧНИКИ ТЕЛЕПРОГРАММЫ (XMLTV / EPG)"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUpdateEpgNow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_focus_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Обновить EPG"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnAddEpgSource"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_focus_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="+ EPG URL"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="В базе EPG: 0 передач"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/epgSourcesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
