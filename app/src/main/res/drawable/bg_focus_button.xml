<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263E5E" />
            <stroke android:width="2.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F3552" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A324D" />
            <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1D2736" />
            <stroke android:width="1dp" android:color="#33475F" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
