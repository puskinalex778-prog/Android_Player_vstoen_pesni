<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263B59" />
            <stroke android:width="2.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22334D" />
            <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C2D42" />
            <stroke android:width="1.5dp" android:color="#6600D4FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
